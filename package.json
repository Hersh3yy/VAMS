{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vue-tsc && vite build && vite build --ssr",
        "dev": "vite",
        "lint": "eslint resources/js --ext .js,.ts,.vue --ignore-path .gitignore --fix",
        "lint:check": "eslint resources/js --ext .js,.ts,.vue --ignore-path .gitignore",
        "format": "prettier --write resources/js/**/*.{js,ts,vue}",
        "format:check": "prettier --check resources/js/**/*.{js,ts,vue}",
        "code:clean": "npm run format && npm run lint"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.2.19",
        "@rushstack/eslint-patch": "^1.15.0",
        "@tailwindcss/forms": "^0.5.10",
        "@types/sortablejs": "^1.15.9",
        "@vitejs/plugin-vue": "^5.0.0",
        "@vue/eslint-config-prettier": "^9.0.0",
        "@vue/eslint-config-typescript": "^13.0.0",
        "@vue/server-renderer": "^3.5.25",
        "autoprefixer": "^10.4.22",
        "axios": "^1.10.0",
        "concurrently": "^9.2.1",
        "eslint": "^8.57.0",
        "eslint-plugin-unused-imports": "^4.3.0",
        "eslint-plugin-vue": "^10.6.2",
        "laravel-vite-plugin": "^2.0.1",
        "postcss": "^8.5.6",
        "prettier": "^3.7.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "tailwindcss": "^3.2.1",
        "typescript": "^5.9.3",
        "vite": "^6.0.11",
        "vue": "^3.5.25",
        "vue-tsc": "^2.0.24"
    },
    "dependencies": {
        "@types/uuid": "^10.0.0",
        "@vueuse/core": "^13.5.0",
        "sortablejs": "^1.15.6",
        "uuid": "^11.1.0",
        "vue3-draggable": "^2.0.9",
        "vue3-toastify": "^0.2.8"
